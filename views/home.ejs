<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Home | The Book Store</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'DM Sans', sans-serif;
        }

        .book-image {
            transition: transform 0.4s ease;
        }

        .book-card:hover .book-image {
            transform: scale(1.04);
        }

        .hero-image {
            transition: transform 0.5s ease;
        }

        .book-card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .book-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 16px 35px rgba(36, 53, 45, 0.10);
        }
    </style>
</head>

<body class="min-h-screen bg-[#F7F5EF] text-[#34443D]">
    <%- include('includes/nav.ejs') %>
    <section class="overflow-hidden px-5 py-14 sm:px-10 lg:px-20 lg:py-20">

        <div class="mx-auto grid max-w-6xl items-center gap-12 md:grid-cols-2">

            <div class="max-w-xl">

                <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#788A82]">
                    A little escape into a good book
                </p>

                <h1 class="mt-5 text-4xl font-bold leading-tight text-[#34443D] sm:text-5xl lg:text-6xl">
                    Every Book Opens
                    <span class="block text-[#788A82]">A New World.</span>
                </h1>

                <p class="mt-5 max-w-md text-base leading-7 text-[#6C766F]">
                    Discover books, explore new ideas and find your next favourite read.
                </p>

                <div class="mt-8 flex flex-wrap items-center gap-4">

                    <a href="/books"
                        class="rounded-lg bg-[#788A82] px-6 py-3 text-sm font-semibold text-white transition hover:bg-[#5E7369]">
                        Explore Books →
                    </a>

                    <a href="/about"
                        class="rounded-lg border border-[#D9E0DA] bg-white px-6 py-3 text-sm font-semibold text-[#34443D] transition hover:bg-[#E8EDE8]">
                        About Us
                    </a>

                </div>

                <div class="mt-10 flex flex-wrap gap-x-8 gap-y-3 text-sm text-[#6C766F]">
                    <span>✓ Different Categories</span>
                    <span>✓ For Every Reader</span>
                </div>

            </div>
            <div class="relative mx-auto w-full max-w-xl">

                <div class="absolute -right-5 -top-5 h-28 w-28 rounded-full bg-[#DDE5DA]"></div>

                <div class="relative overflow-hidden rounded-2xl border border-[#E1E5DE] bg-white p-2 shadow-md">

                    <img
                        src="/uploads/bookstore1.jpg"
                        alt="Bookstore library with tall bookshelves filled with books"
                        class="hero-image h-72 w-full rounded-xl object-cover sm:h-[420px]"
                    >

                </div>

                <div class="absolute -bottom-5 left-4 rounded-xl border border-[#E1E5DE] bg-white p-4 shadow-md sm:-left-5 sm:p-5">

                    <div class="flex items-center gap-3">

                        <div class="flex h-11 w-11 items-center justify-center rounded-lg bg-[#E8EDE8] text-xl">
                         <i class="fa-solid fa-book-open text-[#788A82]"></i>
                        </div>

                        <div>
                            <p class="text-sm font-bold text-[#34443D]">
                                Your next read awaits
                            </p>

                            <p class="mt-1 text-xs text-[#788A82]">
                                Read. Learn. Grow.
                            </p>
                        </div>
                    </div>

                </div>

            </div>

        </div>

    </section>
    <section class="border-y border-[#E4E6DF] bg-white px-5 py-16 sm:px-10 lg:px-20">

        <div class="mx-auto grid max-w-6xl items-center gap-10 md:grid-cols-5">

            <div class="md:col-span-2">

                <p class="text-sm font-semibold uppercase tracking-[0.16em] text-[#788A82]">
                    Get to know us
                </p>

                <h2 class="mt-3 text-3xl font-bold leading-snug text-[#34443D] sm:text-4xl">
                    A Place for Every Book Lover
                </h2>

            </div>

            <div class="md:col-span-3">

                <p class="leading-7 text-[#6C766F]">
                    Welcome to our bookstore, a place where readers can discover new stories, ideas and knowledge.
                </p>

                <p class="mt-4 leading-7 text-[#6C766F]">
                    We bring together books from different categories for students, readers and book lovers.
                </p>

                <a href="/about"
                    class="mt-6 inline-flex items-center gap-2 font-semibold text-[#788A82] transition hover:text-[#34443D]">
                    Read More <span>→</span>
                </a>

            </div>

        </div>

    </section>
    <section class="px-5 py-16 sm:px-10 lg:px-20">

        <div class="mx-auto max-w-6xl">

            <div class="text-center">

                <p class="text-sm font-semibold uppercase tracking-[0.16em] text-[#788A82]">
                    Find your interest
                </p>

                <h2 class="mt-3 text-3xl font-bold text-[#34443D] sm:text-4xl">
                    Explore the World of Books
                </h2>

                <p class="mt-3 text-[#6C766F]">
                    Find books from different categories
                </p>

            </div>

            <div class="mt-8 flex flex-wrap justify-center gap-3">

                <a href="/categories"
                    class="rounded-lg bg-[#788A82] px-5 py-3 text-sm font-semibold text-white transition hover:bg-[#5E7369]">
                    All Books
                </a>

                <a href="/categories/History"
                    class="rounded-lg border border-[#D9E0DA] bg-white px-5 py-3 text-sm font-medium text-[#34443D] transition hover:border-[#788A82] hover:bg-[#E8EDE8]">
                    History
                </a>

                <a href="/categories/Self-Help"
                    class="rounded-lg border border-[#D9E0DA] bg-white px-5 py-3 text-sm font-medium text-[#34443D] transition hover:border-[#788A82] hover:bg-[#E8EDE8]">
                    Self Help
                </a>

                <a href="/categories/Adventure"
                    class="rounded-lg border border-[#D9E0DA] bg-white px-5 py-3 text-sm font-medium text-[#34443D] transition hover:border-[#788A82] hover:bg-[#E8EDE8]">
                    Adventure
                </a>

            </div>

        </div>

    </section>
    <section class="border-y border-[#E0E5DF] bg-[#E8EDE8] px-5 py-16 sm:px-10 lg:px-20">

        <div class="mx-auto max-w-6xl">

            <div class="flex flex-wrap items-end justify-between gap-4">

                <div>

                    <p class="text-sm font-semibold uppercase tracking-[0.16em] text-[#788A82]">
                        A world of stories
                    </p>

                    <h2 class="mt-3 text-3xl font-bold text-[#34443D] sm:text-4xl">
                        Handpicked for Curious Minds
                    </h2>

                    <p class="mt-3 text-[#6C766F]">
                        Explore our collection
                    </p>

                </div>

                <a href="/books"
                    class="font-semibold text-[#52685D] transition hover:text-[#34443D]">
                    View All Books →
                </a>

            </div>
            <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
                <article class="book-card group overflow-hidden rounded-2xl border border-[#E1E5DE] bg-white shadow-sm">

                    <div class="flex h-52 items-center justify-center overflow-hidden bg-[#E8EDE8] p-3 sm:h-56">

                        <img
                            src="https://covers.openlibrary.org/b/title/The%20Hobbit-L.jpg"
                            alt="The Hobbit book cover"
                            loading="lazy"
                            class="book-image h-full w-full object-contain"
                            onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1512820790803-83ca734da794?auto=format&fit=crop&w=600&q=85'; this.classList.remove('object-contain'); this.classList.add('object-cover');"
                        >

                    </div>

                    <div class="flex flex-col p-4">

                        <p class="text-xs font-semibold uppercase tracking-widest text-[#788A82]">
                            Fantasy
                        </p>

                        <h3 class="mt-1.5 text-lg font-bold leading-snug text-[#34443D] group-hover:text-[#788A82]">
                            The Hobbit
                        </h3>

                        <p class="mt-2 text-sm leading-6 text-[#6C766F]">
                            Explore an exciting fantasy world filled with adventure and imagination.
                        </p>

                        <a href="/books"
                            class="mt-4 inline-flex w-fit items-center gap-2 text-sm font-semibold text-[#52685D] transition hover:text-[#34443D]">
                            Explore Collection <span>→</span>
                        </a>

                    </div>

                </article>
                <article class="book-card group overflow-hidden rounded-2xl border border-[#E1E5DE] bg-white shadow-sm">

                    <div class="flex h-52 items-center justify-center overflow-hidden bg-[#E8EDE8] p-3 sm:h-56">

                        <img
                            src="https://covers.openlibrary.org/b/title/Pride%20and%20Prejudice-L.jpg"
                            alt="Pride and Prejudice by Jane Austen book cover"
                            loading="lazy"
                            class="book-image h-full w-full object-contain"
                            onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1544947950-fa07a98d237f?auto=format&fit=crop&w=600&q=85'; this.classList.remove('object-contain'); this.classList.add('object-cover');"
                        >

                    </div>

                    <div class="flex flex-col p-4">

                        <p class="text-xs font-semibold uppercase tracking-widest text-[#788A82]">
                            Romance
                        </p>

                        <h3 class="mt-1.5 text-lg font-bold leading-snug text-[#34443D] group-hover:text-[#788A82]">
                            Pride and Prejudice
                        </h3>

                        <p class="mt-2 text-sm leading-6 text-[#6C766F]">
                            Discover a timeless classic about love, relationships and first impressions.
                        </p>

                        <a href="/books"
                            class="mt-4 inline-flex w-fit items-center gap-2 text-sm font-semibold text-[#52685D] transition hover:text-[#34443D]">
                            Explore Collection <span>→</span>
                        </a>

                    </div>

                </article>
                <article class="book-card group overflow-hidden rounded-2xl border border-[#E1E5DE] bg-white shadow-sm">

                    <div class="flex h-52 items-center justify-center overflow-hidden bg-[#E8EDE8] p-3 sm:h-56">

                        <img
                            src="https://covers.openlibrary.org/b/title/The%20Blue%20Umbrella-L.jpg"
                            alt="The Blue Umbrella by Ruskin Bond book cover"
                            loading="lazy"
                            class="book-image h-full w-full object-contain"
                            onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1497633762265-9d179a990aa6?auto=format&fit=crop&w=600&q=85'; this.classList.remove('object-contain'); this.classList.add('object-cover');"
                        >

                    </div>

                    <div class="flex flex-col p-4">

                        <p class="text-xs font-semibold uppercase tracking-widest text-[#788A82]">
                            Fiction
                        </p>

                        <h3 class="mt-1.5 text-lg font-bold leading-snug text-[#34443D] group-hover:text-[#788A82]">
                            The Blue Umbrella
                        </h3>

                        <p class="mt-2 text-sm leading-6 text-[#6C766F]">
                            Enjoy a heartwarming story by Ruskin Bond.
                        </p>

                        <a href="/books"
                            class="mt-4 inline-flex w-fit items-center gap-2 text-sm font-semibold text-[#52685D] transition hover:text-[#34443D]">
                            Explore Collection <span>→</span>
                        </a>

                    </div>

                </article>


            </div>

        </div>

    </section>
    <section class="px-5 py-16 sm:px-10 lg:px-20">

        <div class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-6 rounded-2xl bg-[#34443D] p-8 sm:p-10 md:flex-row md:items-center">

            <div>

                <p class="text-sm font-semibold uppercase tracking-[0.16em] text-[#D5DFD6]">
                    Need assistance?
                </p>

                <h2 class="mt-3 text-3xl font-bold text-white">
                    Let's Talk Books!
                </h2>

                <p class="mt-3 max-w-lg leading-7 text-white/75">
                    We would love to hear from you.
                </p>

            </div>

            <a href="/contact"
                class="shrink-0 rounded-lg bg-[#E8EDE8] px-6 py-3 text-sm font-semibold text-[#34443D] transition hover:bg-white">
                Contact Us →
            </a>

        </div>

    </section>

    <footer class="border-t border-[#E4E6DF] bg-[#F7F5EF] px-5 py-7 sm:px-10">

        <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-3 text-center sm:flex-row sm:text-left">

            <div>

                <p class="text-lg font-bold text-[#34443D]">
                    The Book Store
                </p>

                <p class="mt-1 text-sm text-[#6C766F]">
                    Read. Learn. Grow.
                </p>

            </div>

            <p class="text-sm text-[#6C766F]">
                © The Book Store. All rights reserved.
            </p>

        </div>

    </footer>

</body>
</html>