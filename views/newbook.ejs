<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Add New Book | The Book Store</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap"
          rel="stylesheet">

    <style>
        * {
            font-family: 'DM Sans', sans-serif;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'DM Sans', sans-serif;
        }

        .form-card {
            box-shadow: 0 18px 50px rgba(41, 75, 57, 0.07);
        }

        .form-input {
            transition: border-color 0.25s ease,
                        box-shadow 0.25s ease,
                        background-color 0.25s ease;
        }

        .form-input:hover {
            border-color: #c4d0c0;
        }

        .form-input:focus {
            border-color: #8ba18e;
            background-color: #ffffff;
            box-shadow: 0 0 0 4px rgba(139, 161, 142, 0.14);
            outline: none;
        }

        .submit-button {
            transition: background-color 0.25s ease,
                        transform 0.25s ease,
                        box-shadow 0.25s ease;
        }

        .submit-button:hover {
            background-color: #1e382a;
            transform: translateY(-2px);
            box-shadow: 0 10px 22px rgba(41, 75, 57, 0.18);
        }

        .submit-button:active {
            transform: translateY(0);
        }

        .back-button {
            transition: all 0.25s ease;
        }

        .back-button:hover {
            border-color: #cbd7c7;
            background-color: #edf2e9;
            transform: translateY(-1px);
        }

        .upload-area {
            transition: border-color 0.25s ease,
                        background-color 0.25s ease;
        }

        .upload-area:hover {
            border-color: #9aaf98;
            background-color: #f3f7f0;
        }

        input[type="file"]::file-selector-button {
            cursor: pointer;
            transition: background-color 0.2s ease;
        }

        input[type="file"]::file-selector-button:hover {
            background-color: #dfe8da;
        }
    </style>
</head>

<body class="min-h-screen bg-[#f7f6f1] text-[#263b30]">
    <%- include('includes/nav.ejs') %>
    <main class="px-4 py-8 sm:px-6 sm:py-10 lg:px-8 lg:py-12">

        <div class="mx-auto max-w-5xl">
            <div class="mb-8">

                <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-[#dce4d9] bg-white px-4 py-2 text-xs font-bold uppercase tracking-[1.8px] text-[#4f6c52] shadow-sm">
                    <span class="text-[#ad8050]">✦</span>
                    Manage Your Collection
                </div>

                <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">

                    <div class="max-w-2xl">

                        <h1 class="text-3xl font-bold tracking-tight text-[#294b39] sm:text-4xl lg:text-[42px]">
                            Add New Book
                            <span class="text-[#ad8050]">.</span>
                        </h1>

                        <p class="mt-3 text-sm leading-7 text-[#788078] sm:text-base">
                            Every book has a story worth sharing. Add a new title to your collection
                            and help readers discover their next favourite.
                        </p>

                    </div>
                    <a href="/books"
                       class="back-button inline-flex w-fit shrink-0 items-center gap-2 rounded-xl border border-[#dce4d9] bg-white px-4 py-3 text-sm font-semibold text-[#365b40] shadow-sm">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="17" height="17" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor"
                             stroke-width="1.8" stroke-linecap="round"
                             stroke-linejoin="round">
                            <path d="m15 18-6-6 6-6"></path>
                        </svg>

                        Back to Books
                    </a>

                </div>

                <div class="mt-6 flex items-center gap-2">
                    <div class="h-1 w-12 rounded-full bg-[#ad8050]"></div>
                    <div class="h-1 w-4 rounded-full bg-[#dce4d9]"></div>
                    <div class="h-1 w-2 rounded-full bg-[#dce4d9]"></div>
                </div>

            </div>
            <section class="form-card overflow-hidden rounded-2xl border border-[#e5e5da] bg-white sm:rounded-3xl">
                <div class="border-b border-[#e1e6dc] bg-[#edf1e9] px-5 py-6 sm:px-8 sm:py-7">

                    <div class="flex items-center gap-4">

                        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl border border-[#dce4d9] bg-white text-[#294b39] shadow-sm">

                            <svg xmlns="http://www.w3.org/2000/svg"
                                 width="25" height="25" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor"
                                 stroke-width="1.7" stroke-linecap="round"
                                 stroke-linejoin="round">
                                <path d="M12 7v14"></path>
                                <path d="M3 18V5a2 2 0 0 1 2-2h3a4 4 0 0 1 4 4 4 4 0 0 1 4-4h3a2 2 0 0 1 2 2v13"></path>
                                <path d="M3 18a2 2 0 0 0 2 2h3a4 4 0 0 1 4 4"></path>
                                <path d="M21 18a2 2 0 0 1-2 2h-3a4 4 0 0 0-4 4"></path>
                            </svg>

                        </div>

                        <div>
                            <h2 class="text-lg font-bold text-[#294b39] sm:text-xl">
                                Book Information
                            </h2>

                            <p class="mt-1 text-sm leading-6 text-[#788078]">
                                Fill in the details to add a new book to your collection.
                            </p>
                        </div>

                    </div>

                </div>
                <form action="/books"
                      method="POST"
                      enctype="multipart/form-data"
                      class="p-5 sm:p-8 lg:p-9">

                    <div class="space-y-6">
                        <div>

                            <label for="title"
                                   class="mb-2.5 block text-sm font-bold text-[#35483b]">
                                Book Title
                                <span class="text-[#ad8050]">*</span>
                            </label>

                            <input
                                type="text"
                                id="title"
                                name="title"
                                placeholder="Enter the book title"
                                required
                                class="form-input w-full rounded-xl border border-[#e4e4da] bg-[#fcfcfa] px-4 py-3.5 text-sm text-[#263b30] placeholder:text-[#a0a69e]"
                            >

                        </div>
                        <div>

                            <label for="author"
                                   class="mb-2.5 block text-sm font-bold text-[#35483b]">
                                Author Name
                                <span class="text-[#ad8050]">*</span>
                            </label>

                            <input
                                type="text"
                                id="author"
                                name="author"
                                placeholder="Enter the author's name"
                                required
                                class="form-input w-full rounded-xl border border-[#e4e4da] bg-[#fcfcfa] px-4 py-3.5 text-sm text-[#263b30] placeholder:text-[#a0a69e]"
                            >

                        </div>
                        <div class="grid gap-5 sm:grid-cols-2">
                            <div>

                                <label for="price"
                                       class="mb-2.5 block text-sm font-bold text-[#35483b]">
                                    Price
                                    <span class="text-[#ad8050]">*</span>
                                </label>

                                <div class="relative">

                                    <span class="pointer-events-none absolute inset-y-0 left-4 flex items-center text-base font-bold text-[#4f6c52]">
                                        ₹
                                    </span>

                                    <input
                                        type="number"
                                        id="price"
                                        name="price"
                                        min="0"
                                        step="0.01"
                                        placeholder="Enter book price"
                                        required
                                        class="form-input w-full rounded-xl border border-[#e4e4da] bg-[#fcfcfa] py-3.5 pl-10 pr-4 text-sm text-[#263b30] placeholder:text-[#a0a69e]"
                                    >

                                </div>

                                <p class="mt-2 text-xs leading-5 text-[#92988f]">
                                    Enter the price in Indian Rupees.
                                </p>

                            </div>
                            <div>

                                <label for="category"
                                       class="mb-2.5 block text-sm font-bold text-[#35483b]">
                                    Book Category
                                    <span class="text-[#ad8050]">*</span>
                                </label>

                                <input
                                    type="text"
                                    id="category"
                                    name="category"
                                    placeholder="e.g. Fiction, Fantasy"
                                    required
                                    class="form-input w-full rounded-xl border border-[#e4e4da] bg-[#fcfcfa] px-4 py-3.5 text-sm text-[#263b30] placeholder:text-[#a0a69e]"
                                >

                                <p class="mt-2 text-xs leading-5 text-[#92988f]">
                                    Select a category that suits your book.
                                </p>

                            </div>

                        </div>
                        <div>

                            <label for="img"
                                   class="mb-2.5 block text-sm font-bold text-[#35483b]">
                                Book Cover Image
                                <span class="text-[#ad8050]">*</span>
                            </label>

                            <div class="upload-area rounded-2xl border border-dashed border-[#cfd9ca] bg-[#f8faf6] p-5 sm:p-7">

                                <div class="flex flex-col items-center text-center">

                                    <div class="mb-4 flex h-14 w-14 items-center justify-center rounded-2xl border border-[#e5e9e1] bg-white text-[#4f6c52] shadow-sm">

                                        <svg xmlns="http://www.w3.org/2000/svg"
                                             width="27" height="27" viewBox="0 0 24 24"
                                             fill="none" stroke="currentColor"
                                             stroke-width="1.7" stroke-linecap="round"
                                             stroke-linejoin="round">
                                            <rect x="3" y="3" width="18" height="18" rx="3"></rect>
                                            <circle cx="8.5" cy="8.5" r="1.5"></circle>
                                            <path d="m21 15-5-5L5 21"></path>
                                        </svg>

                                    </div>

                                    <h3 class="text-sm font-bold text-[#294b39] sm:text-base">
                                        Upload Your Book Cover
                                    </h3>

                                    <p class="mt-2 max-w-sm text-xs leading-6 text-[#788078] sm:text-sm">
                                        Choose a clear image from your computer to give your book
                                        a recognisable look in the collection.
                                    </p>

                                </div>

                                <input
                                    type="file"
                                    id="img"
                                    name="img"
                                    accept="image/*"
                                    required
                                    class="mt-5 block w-full cursor-pointer rounded-xl border border-[#e4e4da] bg-white text-sm text-[#788078] file:mr-3 file:cursor-pointer file:rounded-l-lg file:border-0 file:bg-[#edf2e9] file:px-4 file:py-3 file:font-semibold file:text-[#365b40] hover:file:bg-[#e1e9dc]"
                                >

                            </div>

                            <p class="mt-2 text-xs leading-5 text-[#92988f]">
                                Select an image file for the book cover.
                            </p>

                        </div>

                    </div>
                    <div class="mt-8 flex flex-col-reverse gap-3 border-t border-[#e9e7de] pt-6 sm:flex-row sm:items-center sm:justify-between">
                        <a
                            href="/books"
                            class="back-button inline-flex items-center justify-center gap-2 rounded-xl border border-[#e4e4da] bg-white px-5 py-3.5 text-sm font-semibold text-[#526356]"
                        >

                            <svg xmlns="http://www.w3.org/2000/svg"
                                 width="17" height="17" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor"
                                 stroke-width="1.8" stroke-linecap="round"
                                 stroke-linejoin="round">
                                <path d="m15 18-6-6 6-6"></path>
                            </svg>

                            Cancel
                        </a>
                        <button
                            type="submit"
                            class="submit-button inline-flex items-center justify-center gap-2 rounded-xl bg-[#294b39] px-7 py-3.5 text-sm font-bold text-white shadow-sm focus:outline-none focus:ring-4 focus:ring-[#8ba18e]/30"
                        >

                            <svg xmlns="http://www.w3.org/2000/svg"
                                 width="18" height="18" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round"
                                 stroke-linejoin="round">
                                <path d="M12 5v14"></path>
                                <path d="M5 12h14"></path>
                            </svg>

                            Add Book to Collection

                        </button>

                    </div>

                </form>

            </section>
            <div class="mt-7 flex flex-col items-center justify-center gap-2 text-center sm:flex-row">

                <span class="text-[#ad8050]">✦</span>

                <p class="text-xs leading-6 text-[#858b83]">
                    The Book Store · Made with care for every book lover.
                </p>

            </div>

        </div>

    </main>

</body>
</html>