<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Contact Us | The Book Store</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            font-family: 'DM Sans', sans-serif;
        }

        input,
        textarea,
        button,
        a {
            font-family: 'DM Sans', sans-serif;
        }

        .contact-card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .contact-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 14px 30px rgba(36, 53, 45, 0.08);
        }

        .contact-input {
            width: 100%;
            outline: none;
            transition: border-color 0.2s ease, box-shadow 0.2s ease,
                        background-color 0.2s ease;
        }

        .contact-input:focus {
            border-color: #78966f;
            background-color: #ffffff;
            box-shadow: 0 0 0 4px rgba(120, 150, 111, 0.13);
        }

        .contact-input::placeholder {
            color: #9ca39b;
        }

        .send-button {
            transition: background-color 0.25s ease,
                        transform 0.25s ease,
                        box-shadow 0.25s ease;
        }

        .send-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 18px rgba(49, 91, 67, 0.18);
        }

        .contact-icon {
            transition: background-color 0.25s ease,
                        transform 0.25s ease;
        }

        .contact-card:hover .contact-icon {
            transform: scale(1.05);
            background-color: rgba(255, 255, 255, 0.16);
        }
    </style>
</head>

<body class="min-h-screen bg-[#f7f5ef] text-[#24352d]">
    <%- include('includes/nav.ejs') %>
    <section class="relative overflow-hidden px-5 py-14 text-center sm:py-16 md:py-20">
        <div class="pointer-events-none absolute -right-16 -top-16 h-64 w-64 rounded-full bg-[#e5eadf] opacity-70 blur-3xl"></div>
        <div class="pointer-events-none absolute -bottom-16 -left-12 h-56 w-56 rounded-full bg-[#eadfca] opacity-50 blur-3xl"></div>

        <div class="relative mx-auto max-w-4xl">

            <span class="inline-flex items-center gap-2 rounded-full border border-[#dce5d9] bg-[#edf2e9] px-4 py-2 text-xs font-bold tracking-[0.16em] text-[#315b43] sm:text-sm">
                <span class="h-2 w-2 rounded-full bg-[#78966f]"></span>
                WE'RE HERE TO HELP
            </span>

            <h1 class="mt-5 text-4xl font-bold leading-tight tracking-tight text-[#24352d] sm:text-5xl md:text-6xl">
                Let's Talk
                <span class="text-[#78966f]">Books.</span>
            </h1>

            <p class="mx-auto mt-5 max-w-2xl text-base leading-7 text-[#6b756d] sm:text-lg sm:leading-8">
                Have a question, need help finding a book, or want to share
                your thoughts? We'd love to hear from you.
            </p>

            <div class="mx-auto mt-7 h-1 w-16 rounded-full bg-[#78966f]"></div>

            <p class="mt-4 text-sm font-medium text-[#718071]">
                Every reader's voice matters to us.
            </p>

        </div>
    </section>
    <main class="mx-auto max-w-7xl px-4 pb-14 sm:px-6 sm:pb-16 lg:px-8">

        <div class="grid items-stretch gap-6 lg:grid-cols-5 lg:gap-8">
            <section class="relative overflow-hidden rounded-3xl bg-[#315b43] p-6 text-white shadow-[0_12px_35px_rgba(36,53,45,0.08)] sm:p-8 lg:col-span-2">

                <div class="pointer-events-none absolute -right-14 -top-14 h-48 w-48 rounded-full border border-white/10"></div>
                <div class="pointer-events-none absolute -right-7 -top-7 h-32 w-32 rounded-full border border-white/10"></div>
                <div class="pointer-events-none absolute -bottom-20 -left-16 h-52 w-52 rounded-full bg-white/[0.04] blur-2xl"></div>

                <div class="relative">
                    <div class="flex h-14 w-14 items-center justify-center rounded-2xl border border-white/10 bg-white/10 text-[#e0d0a6]">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="28" height="28" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor"
                             stroke-width="1.7" stroke-linecap="round"
                             stroke-linejoin="round">
                            <path d="M12 7v14"></path>
                            <path d="M3 18V5a2 2 0 0 1 2-2h3a4 4 0 0 1 4 4 4 4 0 0 1 4-4h3a2 2 0 0 1 2 2v13a2 2 0 0 1-2 2h-5a2 2 0 0 0-2 2 2 2 0 0 0-2-2H5a2 2 0 0 1-2-2z"></path>
                        </svg>
                    </div>

                    <p class="mt-6 text-xs font-bold uppercase tracking-[0.2em] text-[#d9c89e] sm:text-sm">
                        Get in Touch
                    </p>

                    <h2 class="mt-3 text-3xl font-bold leading-tight tracking-tight sm:text-4xl">
                        We'd Love to Hear From You
                    </h2>

                    <p class="mt-4 text-sm leading-7 text-white/75 sm:text-base">
                        Every book has a story, and every reader has something
                        to share. Send us your questions, feedback, or suggestions.
                    </p>
                    <div class="mt-8 space-y-4">
                        <div class="contact-card flex items-start gap-4 rounded-2xl border border-white/10 bg-white/[0.07] p-4">

                            <div class="contact-icon flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-white/10 text-[#e0d0a6]">
                                <svg xmlns="http://www.w3.org/2000/svg"
                                     width="21" height="21" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor"
                                     stroke-width="1.7" stroke-linecap="round"
                                     stroke-linejoin="round">
                                    <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                                    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                                </svg>
                            </div>

                            <div class="min-w-0 pt-0.5">
                                <h3 class="font-semibold text-white">
                                    Email Support
                                </h3>

                                <p class="mt-1 text-sm leading-6 text-white/65">
                                    Send us your questions through the contact form.
                                </p>
                            </div>

                        </div>
                        <div class="contact-card flex items-start gap-4 rounded-2xl border border-white/10 bg-white/[0.07] p-4">

                            <div class="contact-icon flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-white/10 text-[#e0d0a6]">
                                <svg xmlns="http://www.w3.org/2000/svg"
                                     width="21" height="21" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor"
                                     stroke-width="1.7" stroke-linecap="round"
                                     stroke-linejoin="round">
                                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.96.35 1.9.7 2.8a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.35 1.84.58 2.8.7A2 2 0 0 1 22 16.92z"></path>
                                </svg>
                            </div>

                            <div class="min-w-0 pt-0.5">
                                <h3 class="font-semibold text-white">
                                    Phone Support
                                </h3>

                                <p class="mt-1 text-sm leading-6 text-white/65">
                                    Need assistance? Leave your contact number in the form.
                                </p>
                            </div>

                        </div>
                        <div class="contact-card flex items-start gap-4 rounded-2xl border border-white/10 bg-white/[0.07] p-4">

                            <div class="contact-icon flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-white/10 text-[#e0d0a6]">
                                <svg xmlns="http://www.w3.org/2000/svg"
                                     width="21" height="21" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor"
                                     stroke-width="1.7" stroke-linecap="round"
                                     stroke-linejoin="round">
                                    <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"></path>
                                    <circle cx="12" cy="10" r="2.5"></circle>
                                </svg>
                            </div>

                            <div class="min-w-0 pt-0.5">
                                <h3 class="font-semibold text-white">
                                    The Book Store
                                </h3>

                                <p class="mt-1 text-sm leading-6 text-white/65">
                                    Your friendly place to discover your next favourite read.
                                </p>
                            </div>

                        </div>

                    </div>
                    <div class="mt-8 border-t border-white/15 pt-6">
                        <div class="flex items-start gap-3">
                            <span class="text-3xl font-bold leading-none text-[#d9c89e]">“</span>

                            <p class="text-base font-semibold leading-7 text-[#e0d0a6]">
                                Every book opens a new world.
                            </p>
                        </div>
                    </div>

                </div>
            </section>
            <section class="rounded-3xl border border-[#e7e5dd] bg-white p-5 shadow-[0_8px_30px_rgba(36,53,45,0.04)] sm:p-8 md:p-9 lg:col-span-3">

                <div class="mb-7 border-b border-[#eeeee8] pb-6">

                    <span class="inline-flex items-center rounded-full bg-[#edf2e9] px-3 py-1.5 text-xs font-bold uppercase tracking-[0.14em] text-[#66816a] sm:text-sm">
                        Send Us a Message
                    </span>

                    <h2 class="mt-4 text-3xl font-bold tracking-tight text-[#24352d] sm:text-4xl">
                        Let's Connect
                    </h2>

                    <p class="mt-3 text-sm leading-7 text-[#788078] sm:text-base">
                        Fill in the details below and share your message with us.
                        Please make sure your information is correct.
                    </p>

                </div>
                <form action="/contact" method="post" class="space-y-5">
                    <div class="grid gap-5 sm:grid-cols-2">

                        <div>
                            <label for="name" class="mb-2 block text-sm font-semibold text-[#34443d]">
                                Your Name
                                <span class="text-[#78966f]">*</span>
                            </label>

                            <input
                                id="name"
                                type="text"
                                name="name"
                                placeholder="Enter your name"
                                autocomplete="name"
                                required
                                class="contact-input rounded-xl border border-[#e0e3dc] bg-[#fafbf8] px-4 py-3.5 text-sm text-[#24352d]"
                            >
                        </div>

                        <div>
                            <label for="mobile" class="mb-2 block text-sm font-semibold text-[#34443d]">
                                Phone Number
                                <span class="text-[#78966f]">*</span>
                            </label>

                            <input
                                id="mobile"
                                type="tel"
                                name="mobile"
                                placeholder="Enter phone number"
                                autocomplete="tel"
                                required
                                class="contact-input rounded-xl border border-[#e0e3dc] bg-[#fafbf8] px-4 py-3.5 text-sm text-[#24352d]"
                            >
                        </div>

                    </div>
                    <div>
                        <label for="email" class="mb-2 block text-sm font-semibold text-[#34443d]">
                            Email Address
                            <span class="text-[#78966f]">*</span>
                        </label>

                        <input
                            id="email"
                            type="email"
                            name="email"
                            placeholder="Enter your email address"
                            autocomplete="email"
                            required
                            class="contact-input rounded-xl border border-[#e0e3dc] bg-[#fafbf8] px-4 py-3.5 text-sm text-[#24352d]"
                        >
                    </div>
                    <div>
                        <label for="message" class="mb-2 block text-sm font-semibold text-[#34443d]">
                            Your Message
                            <span class="text-[#78966f]">*</span>
                        </label>

                        <textarea
                            id="message"
                            name="message"
                            rows="5"
                            placeholder="Tell us how we can help you..."
                            required
                            class="contact-input resize-y rounded-xl border border-[#e0e3dc] bg-[#fafbf8] px-4 py-3.5 text-sm leading-7 text-[#24352d]"
                        ></textarea>
                    </div>
                    <button
                        type="submit"
                        class="send-button flex w-full items-center justify-center gap-2 rounded-xl bg-[#315b43] px-6 py-4 text-sm font-bold text-white shadow-sm focus:outline-none focus:ring-4 focus:ring-[#315b43]/20 sm:text-base"
                    >
                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="19" height="19" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor"
                             stroke-width="1.8" stroke-linecap="round"
                             stroke-linejoin="round">
                            <path d="m22 2-7 20-4-9-9-4Z"></path>
                            <path d="M22 2 11 13"></path>
                        </svg>

                        Send Your Message

                        <span class="ml-1 text-lg">→</span>
                    </button>

                    <p class="flex items-center justify-center gap-2 text-center text-xs leading-5 text-[#929990]">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="14" height="14" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor"
                             stroke-width="1.8" stroke-linecap="round"
                             stroke-linejoin="round">
                            <path d="M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11z"></path>
                            <path d="m9 12 2 2 4-4"></path>
                        </svg>

                        Thank you for reaching out to The Book Store.
                    </p>

                </form>
            </section>

        </div>
        <section class="relative mt-10 overflow-hidden rounded-3xl border border-[#e2e5dc] bg-[#e8ede5] px-5 py-9 text-center sm:mt-12 sm:px-10 sm:py-11">
            <div class="pointer-events-none absolute -right-12 -top-16 h-40 w-40 rounded-full bg-white/40 blur-2xl"></div>
            <div class="pointer-events-none absolute -bottom-16 -left-10 h-40 w-40 rounded-full bg-[#d8e2d3]/70 blur-2xl"></div>

            <div class="relative">

                <span class="inline-flex items-center rounded-full border border-[#d5dfd0] bg-white/60 px-4 py-2 text-xs font-bold uppercase tracking-[0.16em] text-[#66816a] sm:text-sm">
                    A Community of Readers
                </span>

                <h2 class="mx-auto mt-4 max-w-2xl text-2xl font-bold leading-tight tracking-tight text-[#24352d] sm:text-3xl md:text-4xl">
                    Great Stories Begin with a Conversation.
                </h2>

                <p class="mx-auto mt-4 max-w-2xl text-sm leading-7 text-[#6b756d] sm:text-base">
                    Have a book recommendation or feedback about our website?
                    Send us a message — your thoughts matter to us.
                </p>

                <a href="/books"
                   class="mt-6 inline-flex items-center justify-center gap-2 rounded-xl bg-[#315b43] px-6 py-3.5 text-sm font-bold text-white shadow-sm transition duration-300 hover:-translate-y-0.5 hover:bg-[#244832] hover:shadow-md focus:outline-none focus:ring-4 focus:ring-[#315b43]/20">
                    Explore Our Books
                    <span class="text-lg">→</span>
                </a>

            </div>
        </section>

    </main>
    <footer class="border-t border-[#e2e2dc] bg-[#f1f0e9] px-5 py-6 text-center">

        <p class="text-sm leading-6 text-[#788078]">
            © <%= new Date().getFullYear() %> The Book Store.
            Made for readers, with love.
        </p>

    </footer>

</body>
</html>
