
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Order Confirmed | The Book Store</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'DM Sans', sans-serif;
        }
    </style>
</head>

<body class="min-h-screen bg-[#F7F5EF] text-[#34443D]">

    <%- include('includes/nav') %>

    <main class="mx-auto max-w-3xl px-4 py-12 sm:px-6">

        <section class="rounded-3xl border border-[#E8EDE8] bg-white p-6 text-center shadow-sm sm:p-10">
            <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-[#E8EDE8] text-[#34443D]">
                <i class="fa-solid fa-check text-4xl"></i>
            </div>

            <p class="mt-6 text-xs font-bold uppercase tracking-[0.2em] text-[#788A82]">
                The Book Store
            </p>

            <h1 class="mt-3 text-3xl font-bold text-[#34443D] sm:text-4xl">
                Order Confirmed!
            </h1>

            <p class="mx-auto mt-4 max-w-lg leading-7 text-[#6C766F]">
                Thank you, <strong><%= order.fullName %></strong>!
                Your order has been placed successfully.
                We look forward to delivering your favourite books.
            </p>
            <div class="mt-8 rounded-2xl bg-[#F7F5EF] p-5 text-left">

                <h2 class="mb-4 text-xl font-bold text-[#34443D]">
                    Order Summary
                </h2>

                <% order.items.forEach(item => { %>
                    <div class="flex justify-between gap-4 border-b border-[#E8EDE8] py-3">

                        <div>
                            <p class="font-semibold text-[#34443D]">
                                <%= item.title %>
                            </p>

                            <p class="mt-1 text-sm text-[#6C766F]">
                                Quantity: <%= item.quantity %>
                            </p>
                        </div>

                        <p class="shrink-0 font-semibold text-[#34443D]">
                            ₹<%= (item.price * item.quantity).toFixed(2) %>
                        </p>

                    </div>
                <% }) %>

                <div class="mt-5 flex justify-between gap-3 text-lg font-bold text-[#34443D]">
                    <span>Total Paid at Delivery</span>
                    <span>₹<%= Number(order.totalAmount).toFixed(2) %></span>
                </div>

                <p class="mt-3 text-sm text-[#6C766F]">
                    <i class="fa-solid fa-money-bill-wave mr-2 text-[#788A82]"></i>
                    Payment: Cash on Delivery
                </p>

            </div>
            <div class="mt-6 rounded-2xl border border-[#E8EDE8] bg-white p-5 text-left">

                <h2 class="mb-3 text-lg font-bold text-[#34443D]">
                    Delivery Address
                </h2>

                <p class="leading-7 text-[#6C766F]">
                    <%= order.fullName %><br>
                    <%= order.address %><br>
                    <%= order.city %>, <%= order.state %> - <%= order.pincode %><br>
                    Mobile: <%= order.phone %>
                </p>

            </div>
            <a href="/books"
               class="mt-8 inline-flex items-center justify-center rounded-xl bg-[#34443D] px-7 py-3.5 font-semibold text-white transition duration-300 hover:bg-[#788A82]">

                <i class="fa-solid fa-book-open mr-2"></i>
                Continue Shopping

            </a>

            <p class="mt-5 text-sm text-[#6C766F]">
                Happy reading! Thank you for shopping with us.
            </p>

        </section>

    </main>

    <%- include('includes/footer') %>

</body>
</html>
