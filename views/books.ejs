        function getBookDescription(title, savedDescription) {
            if (savedDescription && savedDescription.trim()) {
                return savedDescription.trim();
            }

            const normalizedTitle = title
                .toLowerCase()
                .replace(/[’‘]/g, "'")
                .replace(/[–—]/g, '-')
                .replace(/\s+/g, ' ')
                .trim();

            if (bookDescriptions[normalizedTitle]) {
                return bookDescriptions[normalizedTitle];
            }

            const matchingTitle = Object.keys(bookDescriptions).find(
                key => normalizedTitle.includes(key) || key.includes(normalizedTitle)
            );

            if (matchingTitle) {
                return bookDescriptions[matchingTitle];
            }

            return 'A detailed description for "' + title +
                '" has not been added yet. Add this book\'s description to the ' +
                'description field in your MongoDB database to display its full summary here.';
        }

        // Open the selected book in a side-by-side layout.
        function showBookDescription(book) {
            selectedBook = book;

            detailTitle.textContent = book.dataset.title || 'Untitled Book';
            detailAuthor.textContent = book.dataset.author || 'Unknown Author';
            detailCategory.textContent = book.dataset.category || 'General';
            detailPrice.textContent = '₹' + (book.dataset.price || '0');

            detailDescription.textContent = getBookDescription(
                book.dataset.title || 'Untitled Book',
                book.dataset.description || ''
            );

            detailImage.onload = function () {
                detailImage.classList.remove('hidden');
                detailImageFallback.classList.add('hidden');
            };

            detailImage.onerror = function () {
                detailImage.classList.add('hidden');
                detailImageFallback.classList.remove('hidden');
                detailImage.removeAttribute('src');
            };

            const imageUrl = book.dataset.image || '';

            if (imageUrl.trim()) {
                detailImage.src = imageUrl;
            } else {
                detailImage.removeAttribute('src');
                detailImage.classList.add('hidden');
                detailImageFallback.classList.remove('hidden');
            }

            bookItems.forEach(item => {
                item.classList.remove('selected-book');
                item.classList.add('hidden');
                item.setAttribute('aria-pressed', 'false');
            });

            book.classList.remove('hidden');
            book.classList.add('selected-book');
            book.setAttribute('aria-pressed', 'true');

            // Layout changes only after double-click.
            collectionLayout.classList.add(
                'grid',
                'grid-cols-1',
                'items-start',
                'gap-6',
                'lg:grid-cols-12'
            );

            booksSection.classList.add('min-w-0', 'lg:col-span-5');
            booksGrid.classList.remove('sm:grid-cols-2', 'lg:grid-cols-3');
            booksGrid.classList.add('grid-cols-1');

            descriptionPanel.classList.remove('hidden');
            descriptionPanel.classList.add('lg:col-span-7');

            heroSection.classList.add('hidden');
            filterSection.classList.add('hidden');
            bookCount.classList.add('hidden');

            collectionSubtitle.textContent =
                'Explore the details and description of your selected book.';

            document.getElementById('book-collection').scrollIntoView({
                behavior: 'smooth',
                block: 'start'
            });
        }

        function showAllBooks() {
            selectedBook = null;

            bookItems.forEach(item => {
                item.classList.remove('hidden', 'selected-book');
                item.setAttribute('aria-pressed', 'false');
            });

            collectionLayout.classList.remove(
                'grid',
                'grid-cols-1',
                'items-start',
                'gap-6',
                'lg:grid-cols-12'
            );

            booksSection.classList.remove('min-w-0', 'lg:col-span-5');
            booksGrid.classList.remove('grid-cols-1');
            booksGrid.classList.add('sm:grid-cols-2', 'lg:grid-cols-3');

            descriptionPanel.classList.add('hidden');
            descriptionPanel.classList.remove('lg:col-span-7');

            heroSection.classList.remove('hidden');
            filterSection.classList.remove('hidden');
            bookCount.classList.remove('hidden');

            if (showSavedOnly) {
                collectionSubtitle.textContent =
                    'Your saved books are collected here for easy access.';
            } else {
                collectionSubtitle.textContent =
                    'Discover a book that speaks to you. Double-click any book to read its description.';
            }

            filterBooks();

            document.getElementById('book-collection').scrollIntoView({
                behavior: 'smooth',
                block: 'start'
            });
        }
        bookItems.forEach(book => {
            book.setAttribute('aria-pressed', 'false');

            book.addEventListener('dblclick', function (event) {
                if (event.target.closest('a, button, form')) {
                    return;
                }

                showBookDescription(book);
            });

            book.addEventListener('keydown', function (event) {
                if (
                    (event.key === 'Enter' || event.key === ' ') &&
                    !event.target.closest('a, button, form')
                ) {
                    event.preventDefault();
                    showBookDescription(book);
                }
            });
        });

        backToBooks.addEventListener('click', showAllBooks);

        function filterBooks() {
            const searchText = searchInput.value.toLowerCase().trim();
            const selectedCategory = categoryFilter.value.toLowerCase();

            let visibleBooks = 0;

            bookItems.forEach(book => {
                const title = (book.dataset.title || '').toLowerCase();
                const author = (book.dataset.author || '').toLowerCase();
                const category = (book.dataset.category || '').toLowerCase();
                const bookId = String(book.dataset.bookId);

                const matchesSearch =
                    title.includes(searchText) ||
                    author.includes(searchText);

                const matchesCategory =
                    selectedCategory === '' ||
                    category === selectedCategory;

                const matchesSaved =
                    !showSavedOnly || isBookSaved(bookId);

                const matches =
                    matchesSearch && matchesCategory && matchesSaved;

                if (matches) {
                    visibleBooks++;
                }

                if (selectedBook) {
                    book.classList.toggle(
                        'hidden',
                        book !== selectedBook || !matches
                    );
                } else {
                    book.classList.toggle('hidden', !matches);
                }
            });

            if (noResults && booksGrid) {
                noResults.classList.toggle('hidden', visibleBooks !== 0);
                booksGrid.classList.toggle('hidden', visibleBooks === 0);

                if (visibleBooks === 0 && showSavedOnly) {
                    noResultsTitle.textContent = 'No saved books yet';

                    noResultsMessage.textContent =
                        'Click the bookmark icon on any book to save it here.';
                } else {
                    noResultsTitle.textContent = 'No books found';

                    noResultsMessage.textContent =
                        'Try another title, author or category.';
                }
            }

            if (
                selectedBook &&
                (
                    (
                        !(selectedBook.dataset.title || '').toLowerCase().includes(searchText) &&
                        !(selectedBook.dataset.author || '').toLowerCase().includes(searchText)
                    ) ||
                    (
                        selectedCategory !== '' &&
                        (selectedBook.dataset.category || '').toLowerCase() !== selectedCategory
                    ) ||
                    (showSavedOnly && !isBookSaved(selectedBook.dataset.bookId))
                )
            ) {
                showAllBooks();
            }
        }

        searchInput.addEventListener('input', function () {
            if (selectedBook) {
                showAllBooks();
            }

            filterBooks();
        });

        categoryFilter.addEventListener('change', function () {
            if (selectedBook) {
                showAllBooks();
            }

            filterBooks();
        });
        if (resetSearch) {
            resetSearch.addEventListener('click', function () {
                searchInput.value = '';
                categoryFilter.value = '';
                showSavedOnly = false;

                updateSavedInterface();
                showAllBooks();
            });
        }

        updateSavedInterface();
        filterBooks();
    </script>

</body>
