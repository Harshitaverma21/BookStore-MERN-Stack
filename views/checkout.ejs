<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Checkout | The Book Store</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        html { scroll-behavior: smooth; }
        body { font-family: 'DM Sans', sans-serif; }
        h1, h2, h3, p, a, button, label, input, textarea, span { font-family: 'DM Sans', sans-serif; }
        .field {
            width: 100%;
            border: 1px solid #D9E0DA;
            border-radius: 10px;
            padding: 12px 14px;
            outline: none;
            background: #FFFFFF;
            color: #34443D;
            font-family: 'DM Sans', sans-serif;
            font-size: 14px;
            transition: border-color .2s ease, box-shadow .2s ease;
        }
        .field::placeholder { color: #9A9F98; }
        .field:focus {
            border-color: #788A82;
            box-shadow: 0 0 0 3px rgba(120, 138, 130, .12);
        }
        textarea.field { resize: vertical; }
        .checkout-card {
            background: #FFFFFF;
            border: 1px solid #E1E5DE;
            border-radius: 16px;
            box-shadow: 0 5px 22px rgba(36, 53, 45, .045);
        }
        .section-icon {
            display: flex;
            height: 44px;
            width: 44px;
            flex-shrink: 0;
            align-items: center;
            justify-content: center;
            border-radius: 10px;
            background: #E8EDE8;
            color: #788A82;
        }
        .payment-option {
            border: 1.5px solid #D9E0DA;
            background: #F7F9F6;
            transition: border-color .2s ease, background .2s ease;
        }
        .payment-option:hover {
            border-color: #788A82;
            background: #E8EDE8;
        }
        .primary-btn {
            background: #788A82;
            transition: background .2s ease, transform .2s ease;
        }
        .primary-btn:hover {
            background: #5E7369;
            transform: translateY(-1px);
        }
        .secondary-btn { transition: background .2s ease, border-color .2s ease; }
        .secondary-btn:hover {
            background: #E8EDE8;
            border-color: #788A82;
        }
        .book-row {
            padding: 14px 0;
            border-bottom: 1px solid #EAEDE7;
        }
        .book-row:last-child { border-bottom: none; }
        @media (max-width: 640px) {
            .checkout-heading { font-size: 36px; }
        }
    </style>
</head>
<body class="min-h-screen bg-[#F7F5EF] text-[#34443D]">

    <%- include('includes/nav.ejs') %>
    <main class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10 lg:py-14">
        
        <div class="mb-8 sm:mb-10">
            <p class="mb-3 text-xs font-bold uppercase tracking-[0.22em] text-[#788A82]">
                <i class="fa-solid fa-book-open mr-2"></i>The Book Store
            </p>
            <h1 class="checkout-heading text-4xl font-bold leading-tight text-[#34443D] sm:text-5xl">Checkout</h1>
            <p class="mt-3 max-w-xl text-sm leading-7 text-[#6C766F] sm:text-base">
                Just a few details and your next favourite book will be on its way.
            </p>
        </div>
        <form action="/checkout" method="POST" class="grid items-start gap-6 lg:grid-cols-[minmax(0,1fr)_350px] lg:gap-7">
          
            <section class="checkout-card p-5 sm:p-7 lg:p-8">
                <div class="mb-7 flex items-center gap-3 border-b border-[#E4E6DF] pb-5">
                    <div class="section-icon">
                        <i class="fa-solid fa-truck-fast text-lg"></i>
                    </div>
                    <div>
                        <h2 class="text-2xl font-bold text-[#34443D]">Delivery Details</h2>
                        <p class="mt-1 text-sm text-[#6C766F]">Where should we deliver your books?</p>
                    </div>
                </div>
                <% if (typeof error !== 'undefined' && error) { %>
                    <div role="alert" class="mb-5 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-700">
                        <i class="fa-solid fa-circle-exclamation mr-2"></i>
                        <%= error %>
                    </div>
                <% } %>
                <div class="mb-5">
                    <label for="fullName" class="mb-2 block text-sm font-semibold text-[#34443D]">Full Name *</label>
                    <input class="field" id="fullName" name="fullName" type="text" required maxlength="100" autocomplete="name" value="<%= formData.fullName || currentUserName || '' %>" placeholder="Enter your full name">
                </div>
                <div class="mb-5">
                    <label for="email" class="mb-2 block text-sm font-semibold text-[#34443D]">Email Address *</label>
                    <input class="field" id="email" name="email" type="email" required maxlength="254" autocomplete="email" value="<%= formData.email || '' %>" placeholder="you@example.com">
                </div>
                <div class="mb-5">
                    <label for="phone" class="mb-2 block text-sm font-semibold text-[#34443D]">Mobile Number *</label>
                    <input class="field" id="phone" name="phone" type="tel" required pattern="[6-9][0-9]{9}" maxlength="10" minlength="10" inputmode="numeric" autocomplete="tel" value="<%= formData.phone || '' %>" placeholder="10-digit mobile number">
                </div>
                <div class="mb-5">
                    <label for="address" class="mb-2 block text-sm font-semibold text-[#34443D]">Full Address *</label>
                    <textarea class="field" id="address" name="address" rows="3" required maxlength="500" autocomplete="street-address" placeholder="House number, street, area..."><%= formData.address || '' %></textarea>
                </div>
                <div class="mb-5 grid gap-5 sm:grid-cols-2">
                    <div>
                        <label for="city" class="mb-2 block text-sm font-semibold text-[#34443D]">City *</label>
                        <input class="field" id="city" name="city" type="text" required maxlength="100" autocomplete="address-level2" value="<%= formData.city || '' %>" placeholder="Your city">
                    </div>
                    <div>
                        <label for="state" class="mb-2 block text-sm font-semibold text-[#34443D]">State *</label>
                        <input class="field" id="state" name="state" type="text" required maxlength="100" autocomplete="address-level1" value="<%= formData.state || '' %>" placeholder="Your state">
                    </div>
                </div>
                <div class="mb-7">
                    <label for="pincode" class="mb-2 block text-sm font-semibold text-[#34443D]">PIN Code *</label>
                    <input class="field" id="pincode" name="pincode" type="text" required pattern="[1-9][0-9]{5}" minlength="6" maxlength="6" inputmode="numeric" autocomplete="postal-code" value="<%= formData.pincode || '' %>" placeholder="6-digit PIN code">
                </div>
                <div class="border-t border-[#E4E6DF] pt-6">
                    <h2 class="mb-4 text-2xl font-bold text-[#34443D]">Payment Method</h2>
                    <label class="payment-option flex cursor-pointer items-center gap-4 rounded-xl p-4">
                        <input type="radio" name="paymentMethod" value="Cash on Delivery" checked required class="h-4 w-4 accent-[#788A82]">
                        <span class="flex-1">
                            <span class="block font-bold text-[#34443D]">Cash on Delivery</span>
                            <span class="mt-1 block text-sm text-[#6C766F]">Pay when your books arrive.</span>
                        </span>
                        <i class="fa-solid fa-money-bill-wave text-2xl text-[#788A82]"></i>
                    </label>
                    <p class="mt-4 text-xs leading-5 text-[#6C766F]">
                        <i class="fa-solid fa-shield-halved mr-1 text-[#788A82]"></i>
                        Your delivery details will be used to process your order.
                    </p>
                </div>
            </section>
            <aside class="checkout-card h-fit p-5 sm:p-6 lg:sticky lg:top-6">
                <h2 class="text-2xl font-bold text-[#34443D]">Order Summary</h2>
                <p class="mt-1 text-sm text-[#6C766F]">Your selected books</p>
                <div class="mt-5">
                    <% cart.forEach(item => { %>
                        <div class="book-row flex items-start gap-3">
                            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-[#E8EDE8] text-[#788A82]">
                                <i class="fa-solid fa-book"></i>
                            </div>
                            <div class="min-w-0 flex-1">
                                <p class="break-words text-sm font-semibold text-[#34443D]"><%= item.title %></p>
                                <p class="mt-1 text-xs text-[#6C766F]">₹<%= Number(item.price || 0).toFixed(2) %> × <%= item.quantity || 1 %></p>
                            </div>
                            <p class="shrink-0 text-sm font-bold text-[#34443D]">₹<%= (Number(item.price || 0) * Number(item.quantity || 1)).toFixed(2) %></p>
                        </div>
                    <% }) %>
                </div>
                <div class="my-5 border-t border-dashed border-[#D9E0DA]"></div>
                <div class="flex justify-between text-sm text-[#6C766F]">
                    <span>Total Books</span>
                    <span class="text-[#34443D]"><%= cart.reduce((sum, item) => sum + Number(item.quantity || 1), 0) %></span>
                </div>
                <div class="mt-4 flex justify-between text-sm text-[#6C766F]">
                    <span>Delivery Charges</span>
                    <span class="font-semibold text-[#788A82]">FREE</span>
                </div>
                <div class="my-5 border-t border-[#E1E5DE]"></div>
                <div class="flex items-center justify-between gap-3">
                    <span class="text-lg font-bold text-[#34443D]">Grand Total</span>
                    <span class="text-2xl font-bold text-[#34443D]">₹<%= Number(total || 0).toFixed(2) %></span>
                </div>
                <button type="submit" class="primary-btn mt-6 w-full rounded-lg px-5 py-4 font-semibold text-white focus:outline-none focus:ring-4 focus:ring-[#D9E0DA]">
                    Place Order
                    <i class="fa-solid fa-arrow-right ml-2"></i>
                </button>
                <a href="/cart" class="secondary-btn mt-4 block rounded-lg border border-[#D9E0DA] px-5 py-3 text-center text-sm font-semibold text-[#34443D]">
                    <i class="fa-solid fa-arrow-left mr-2"></i>
                    Back to Cart
                </a>
                <p class="mt-5 text-center text-xs leading-5 text-[#6C766F]">
                    <i class="fa-solid fa-book-open mr-1 text-[#788A82]"></i>
                    Thank you for choosing The Book Store.
                </p>
            </aside>
        </form>
    </main>
    <%- include('includes/footer') %>
</body>
</html>
