<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Admin Login | The Book Store</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    <style>
        * {
            font-family: 'DM Sans', sans-serif;
        }

        body {
            font-family: 'DM Sans', sans-serif;
        }

        .login-card {
            box-shadow: 0 15px 45px rgba(36, 53, 45, 0.07);
        }

        .input-field {
            transition: all 0.25s ease;
        }

        .input-field:focus {
            border-color: #315b43;
            background-color: #ffffff;
            box-shadow: 0 0 0 3px rgba(49, 91, 67, 0.09);
            outline: none;
        }

        .login-button {
            transition: all 0.25s ease;
        }

        .login-button:hover {
            background-color: #244832;
            transform: translateY(-1px);
            box-shadow: 0 8px 18px rgba(49, 91, 67, 0.15);
        }

        .login-button:active {
            transform: translateY(0);
        }

        .decoration {
            pointer-events: none;
            position: absolute;
            border-radius: 50%;
        }

        input:-webkit-autofill,
        input:-webkit-autofill:hover,
        input:-webkit-autofill:focus {
            -webkit-text-fill-color: #24352d;
            transition: background-color 5000s ease-in-out 0s;
        }
    </style>
</head>

<body class="min-h-screen bg-[#f7f5ef] text-[#24352d]">
    <%- include('includes/nav.ejs') %>
    <main class="relative flex min-h-[82vh] items-center justify-center overflow-hidden px-4 py-10 sm:px-6 lg:py-14">
        <div class="decoration -left-24 top-20 h-64 w-64 bg-[#e5eadf] opacity-60 blur-3xl"></div>
        <div class="decoration -bottom-24 right-0 h-72 w-72 bg-[#e9e3d5] opacity-70 blur-3xl"></div>

        <div class="relative z-10 w-full max-w-5xl">
            <div class="mb-8 text-center">

                <p class="mb-2 text-xs font-bold uppercase tracking-[0.2em] text-[#78966f]">
                    The Book Store
                </p>

                <h1 class="text-3xl font-bold tracking-tight text-[#24352d] sm:text-4xl">
                    Admin Login
                </h1>

                <p class="mx-auto mt-3 max-w-md text-sm leading-6 text-[#737a72] sm:text-base">
                    Welcome back! Sign in to manage your bookstore.
                </p>

            </div>
            <div class="login-card grid w-full overflow-hidden rounded-3xl border border-[#e7e5dc] bg-white md:grid-cols-2">
                <section class="relative flex flex-col justify-between overflow-hidden bg-[#315b43] p-7 text-white sm:p-10 lg:p-12">
                    <div class="pointer-events-none absolute -right-16 -top-16 h-56 w-56 rounded-full border border-white/10"></div>
                    <div class="pointer-events-none absolute -right-7 -top-7 h-36 w-36 rounded-full border border-white/10"></div>
                    <div class="pointer-events-none absolute -bottom-20 -left-16 h-64 w-64 rounded-full bg-white/[0.04]"></div>

                    <div class="relative z-10">
                        <div class="mb-7 flex h-14 w-14 items-center justify-center rounded-2xl border border-white/15 bg-white/10">
                            <svg xmlns="http://www.w3.org/2000/svg"
                                width="28" height="28" viewBox="0 0 24 24"
                                fill="none" stroke="currentColor"
                                stroke-width="1.7" stroke-linecap="round"
                                stroke-linejoin="round">
                                <path d="M12 7v14"></path>
                                <path d="M3 18V5a2 2 0 0 1 2-2h3a4 4 0 0 1 4 4 4 4 0 0 1 4-4h3a2 2 0 0 1 2 2v13"></path>
                                <path d="M3 18a2 2 0 0 0 2 2h3a4 4 0 0 1 4 4"></path>
                                <path d="M21 18a2 2 0 0 1-2 2h-3a4 4 0 0 0-4 4"></path>
                            </svg>
                        </div>

                        <p class="mb-3 text-xs font-bold uppercase tracking-[0.18em] text-[#d6e1d0]">
                            Your Bookstore
                        </p>

                        <h2 class="max-w-sm text-2xl font-bold leading-snug tracking-tight sm:text-3xl">
                            Every Book Has a Story.
                        </h2>

                        <p class="mt-4 max-w-sm text-sm leading-7 text-white/75">
                            Keep your collection organized, manage your books
                            and make every reader's experience special.
                        </p>
                        <div class="mt-9 space-y-5">

                            <div class="flex items-center gap-3">
                                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-white/10 text-[#e0e9d8]">
                                    <svg xmlns="http://www.w3.org/2000/svg"
                                        width="20" height="20" viewBox="0 0 24 24"
                                        fill="none" stroke="currentColor"
                                        stroke-width="1.7" stroke-linecap="round"
                                        stroke-linejoin="round">
                                        <path d="M12 7v14"></path>
                                        <path d="M3 18V5a2 2 0 0 1 2-2h3a4 4 0 0 1 4 4 4 4 0 0 1 4-4h3a2 2 0 0 1 2 2v13"></path>
                                    </svg>
                                </div>

                                <div>
                                    <p class="text-sm font-semibold">Book Collection</p>
                                    <p class="mt-1 text-xs leading-5 text-white/65">
                                        Keep your books organized
                                    </p>
                                </div>
                            </div>

                            <div class="flex items-center gap-3">
                                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-white/10 text-[#e0e9d8]">
                                    <svg xmlns="http://www.w3.org/2000/svg"
                                        width="20" height="20" viewBox="0 0 24 24"
                                        fill="none" stroke="currentColor"
                                        stroke-width="1.7" stroke-linecap="round"
                                        stroke-linejoin="round">
                                        <circle cx="9" cy="21" r="1"></circle>
                                        <circle cx="20" cy="21" r="1"></circle>
                                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                                    </svg>
                                </div>

                                <div>
                                    <p class="text-sm font-semibold">Store Management</p>
                                    <p class="mt-1 text-xs leading-5 text-white/65">
                                        Manage your bookstore with ease
                                    </p>
                                </div>
                            </div>

                            <div class="flex items-center gap-3">
                                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-white/10 text-[#e0e9d8]">
                                    <svg xmlns="http://www.w3.org/2000/svg"
                                        width="20" height="20" viewBox="0 0 24 24"
                                        fill="none" stroke="currentColor"
                                        stroke-width="1.7" stroke-linecap="round"
                                        stroke-linejoin="round">
                                        <path d="M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                        <circle cx="10" cy="7" r="4"></circle>
                                        <path d="M20 21v-2a4 4 0 0 0-3-3.87"></path>
                                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                                    </svg>
                                </div>

                                <div>
                                    <p class="text-sm font-semibold">Reader Experience</p>
                                    <p class="mt-1 text-xs leading-5 text-white/65">
                                        Make book discovery enjoyable
                                    </p>
                                </div>
                            </div>

                        </div>
                    </div>
                    <div class="relative z-10 mt-10 border-t border-white/15 pt-6">
                        <p class="text-sm italic leading-6 text-white/85">
                            "A room without books is like a body without a soul."
                        </p>

                        <p class="mt-2 text-xs font-medium text-[#d6e1d0]">
                            A little reminder for every book lover.
                        </p>
                    </div>

                </section>
                <section class="flex items-center justify-center bg-white px-6 py-9 sm:px-10 sm:py-12 lg:px-12">

                    <div class="w-full max-w-sm">
                        <div class="mb-6 flex h-12 w-12 items-center justify-center rounded-2xl bg-[#edf2e9] text-[#315b43]">
                            <svg xmlns="http://www.w3.org/2000/svg"
                                width="24" height="24" viewBox="0 0 24 24"
                                fill="none" stroke="currentColor"
                                stroke-width="1.7" stroke-linecap="round"
                                stroke-linejoin="round">
                                <rect x="3" y="11" width="18" height="11" rx="2"></rect>
                                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                            </svg>
                        </div>

                        <p class="mb-2 text-xs font-bold uppercase tracking-[0.18em] text-[#78966f]">
                            Authorized Access
                        </p>

                        <h2 class="text-3xl font-bold tracking-tight text-[#24352d] sm:text-4xl">
                            Sign In
                        </h2>

                        <p class="mt-3 text-sm leading-6 text-[#737a72]">
                            Enter your login details to access your admin panel.
                        </p>
                        <form action="/admin/login" method="POST" class="mt-8 space-y-5">
                            <div>
                                <label for="username" class="mb-2 block text-sm font-semibold text-[#35483b]">
                                    Username
                                </label>

                                <div class="relative">
                                    <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-[#849184]">
                                        <svg xmlns="http://www.w3.org/2000/svg"
                                            width="19" height="19" viewBox="0 0 24 24"
                                            fill="none" stroke="currentColor"
                                            stroke-width="1.7" stroke-linecap="round"
                                            stroke-linejoin="round">
                                            <circle cx="12" cy="8" r="4"></circle>
                                            <path d="M5 21a7 7 0 0 1 14 0"></path>
                                        </svg>
                                    </span>

                                    <input
                                        type="text"
                                        id="username"
                                        name="username"
                                        placeholder="Enter your username"
                                        autocomplete="username"
                                        required
                                        class="input-field w-full rounded-xl border border-[#e1e5dc] bg-[#fcfcfa] py-3.5 pl-11 pr-4 text-sm text-[#24352d] placeholder:text-[#a0a69e]"
                                    >
                                </div>
                            </div>
                            <div>
                                <label for="password" class="mb-2 block text-sm font-semibold text-[#35483b]">
                                    Password
                                </label>

                                <div class="relative">
                                    <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-[#849184]">
                                        <svg xmlns="http://www.w3.org/2000/svg"
                                            width="19" height="19" viewBox="0 0 24 24"
                                            fill="none" stroke="currentColor"
                                            stroke-width="1.7" stroke-linecap="round"
                                            stroke-linejoin="round">
                                            <rect x="3" y="11" width="18" height="11" rx="2"></rect>
                                            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                        </svg>
                                    </span>

                                    <input
                                        type="password"
                                        id="password"
                                        name="password"
                                        placeholder="Enter your password"
                                        autocomplete="current-password"
                                        required
                                        class="input-field w-full rounded-xl border border-[#e1e5dc] bg-[#fcfcfa] py-3.5 pl-11 pr-4 text-sm text-[#24352d] placeholder:text-[#a0a69e]"
                                    >
                                </div>
                            </div>
                            <button
                                type="submit"
                                class="login-button mt-2 flex w-full items-center justify-center gap-2 rounded-xl bg-[#315b43] px-5 py-3.5 text-sm font-bold text-white shadow-md shadow-[#315b43]/10 focus:outline-none focus:ring-4 focus:ring-[#315b43]/20"
                            >
                                Login to Dashboard

                                <svg xmlns="http://www.w3.org/2000/svg"
                                    width="18" height="18" viewBox="0 0 24 24"
                                    fill="none" stroke="currentColor"
                                    stroke-width="2" stroke-linecap="round"
                                    stroke-linejoin="round">
                                    <path d="M5 12h14"></path>
                                    <path d="m12 5 7 7-7 7"></path>
                                </svg>
                            </button>

                        </form>
                        <div class="mt-8 flex items-center gap-3">
                            <div class="h-px flex-1 bg-[#e8e9e2]"></div>

                            <span class="whitespace-nowrap text-[10px] font-bold tracking-[0.18em] text-[#92978f]">
                                THE BOOK STORE
                            </span>

                            <div class="h-px flex-1 bg-[#e8e9e2]"></div>
                        </div>
                        <div class="mt-6 flex items-start justify-center gap-2.5">
                            <svg xmlns="http://www.w3.org/2000/svg"
                                width="17" height="17" viewBox="0 0 24 24"
                                fill="none" stroke="#78966f"
                                stroke-width="1.8" stroke-linecap="round"
                                stroke-linejoin="round" class="mt-0.5 shrink-0">
                                <path d="M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11z"></path>
                                <path d="m9 12 2 2 4-4"></path>
                            </svg>

                            <p class="text-center text-xs leading-5 text-[#858b83]">
                                Secure access for authorized administrators only.
                            </p>
                        </div>

                    </div>

                </section>

            </div>
            <div class="mt-6 text-center">
                <a href="/"
                    class="inline-flex items-center gap-2 text-sm font-semibold text-[#52745a] transition hover:text-[#24352d]">
                    <svg xmlns="http://www.w3.org/2000/svg"
                        width="16" height="16" viewBox="0 0 24 24"
                        fill="none" stroke="currentColor"
                        stroke-width="1.8" stroke-linecap="round"
                        stroke-linejoin="round">
                        <path d="m15 18-6-6 6-6"></path>
                    </svg>

                    Back to Store
                </a>
            </div>

        </div>

    </main>
    <footer class="border-t border-[#e5e3da] bg-[#f7f5ef] px-5 py-5 text-center">
        <p class="text-xs leading-6 text-[#777e75]">
            © <%= new Date().getFullYear() %> The Book Store.
            Made with care for every book lover.
        </p>
    </footer>

</body>
</html>