<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>About Us | The Book Store</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <style>
        html { scroll-behavior: smooth; }
        body, body * { font-family: 'DM Sans', sans-serif; }
        .feature-card, .book-card { transition: transform 0.3s ease, box-shadow 0.3s ease; }
        .feature-card:hover, .book-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 16px 35px rgba(36, 53, 45, 0.10);
        }
        .book-cover {
            width: 100%;
            height: 190px;
            object-fit: contain;
            padding: 12px;
            background: #f1f0e9;
            transition: transform 0.4s ease;
        }
        .book-card:hover .book-cover { transform: scale(1.04); }
        .book-placeholder {
            display: none;
            width: 100%;
            height: 190px;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 10px;
            padding: 12px;
            background: linear-gradient(135deg, #e8ede5, #f7f5ef);
            color: #315b43;
            text-align: center;
        }
        .hero-image { transition: transform 0.5s ease; }
        .hero-image:hover { transform: scale(1.02); }
        .section-label {
            color: #788a82;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.18em;
            text-transform: uppercase;
        }
        ::selection { background: #dce5d9; color: #24352d; }
    </style>
</head>
<body class="min-h-screen bg-[#F7F5EF] text-[#34443D]">
    <%- include('includes/nav.ejs') %>
    <section class="relative overflow-hidden px-5 py-16 sm:px-10 lg:px-20 lg:py-20">
        <div class="pointer-events-none absolute -right-16 -top-16 h-64 w-64 rounded-full bg-[#DDE5DA] opacity-70 blur-3xl"></div>
        <div class="pointer-events-none absolute -bottom-20 -left-12 h-64 w-64 rounded-full bg-[#EAE0CF] opacity-60 blur-3xl"></div>
        <div class="relative mx-auto max-w-5xl text-center">
            <span class="inline-flex items-center gap-2 rounded-full border border-[#D9E0DA] bg-white/80 px-4 py-2 text-xs font-bold tracking-[0.16em] text-[#52685D] shadow-sm">
                <span class="h-2 w-2 rounded-full bg-[#788A82]"></span>
                OUR STORY
            </span>
            <h1 class="mt-6 text-4xl font-bold leading-tight tracking-tight text-[#34443D] sm:text-5xl md:text-6xl">
                About Our <span class="text-[#788A82]">Bookstore.</span>
            </h1>
            <p class="mx-auto mt-6 max-w-2xl text-base leading-8 text-[#6C766F] sm:text-lg">
                Welcome to The Book Store, a place where stories come alive,
                ideas grow, and every reader can discover something special.
                Find your next favourite read and let every page take you somewhere new.
            </p>
            <div class="mt-8 flex flex-wrap justify-center gap-4">
                <a href="/books" class="rounded-xl bg-[#788A82] px-7 py-3.5 text-sm font-semibold text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-[#5E7369]">
                    Explore Our Books →
                </a>
                <a href="/categories" class="rounded-xl border border-[#D9E0DA] bg-white px-7 py-3.5 text-sm font-semibold text-[#34443D] transition hover:border-[#788A82] hover:bg-[#E8EDE8]">
                    Browse Categories
                </a>
            </div>
            <div class="mx-auto mt-12 h-1 w-16 rounded-full bg-[#788A82]"></div>
            <div class="mt-8 flex flex-wrap justify-center gap-x-8 gap-y-3 text-sm text-[#6C766F]">
                <span>✓ Discover New Stories</span>
                <span>✓ Explore Different Categories</span>
                <span>✓ Find Your Next Favourite</span>
            </div>
        </div>
    </section>
    <section class="px-5 pb-16 sm:px-10 lg:px-20">
        <div class="mx-auto grid max-w-6xl items-center gap-10 overflow-hidden rounded-3xl border border-[#E1E5DE] bg-white p-5 shadow-sm sm:p-8 md:grid-cols-2 md:gap-12 md:p-10">
            <div class="relative">
                <div class="absolute -bottom-3 -right-3 h-full w-full rounded-2xl bg-[#E8EDE8]"></div>
                <div class="relative overflow-hidden rounded-2xl border border-[#E1E5DE] bg-[#E8EDE8] p-2">
                    <img src="/uploads/img1.jpg" alt="Books and reading at The Book Store"
                         class="hero-image h-72 w-full rounded-xl object-cover sm:h-80 md:h-[390px]"
                         onerror="this.onerror=null; this.src='/uploads/bookstore2.jpg';">
                </div>
                <div class="absolute bottom-5 left-5 rounded-xl border border-[#E1E5DE] bg-white/95 px-4 py-3 shadow-md sm:bottom-6 sm:left-6">
                    <p class="text-sm font-bold text-[#34443D]">A World of Stories</p>
                    <p class="mt-1 text-xs text-[#788A82]">Made for every reader</p>
                </div>
            </div>
            <div class="py-3 md:py-5">
                <p class="section-label">Welcome to Our World</p>
                <h2 class="mt-3 text-3xl font-bold leading-tight tracking-tight text-[#34443D] sm:text-4xl">A Place for Every Reader</h2>
                <div class="mt-5 h-1 w-14 rounded-full bg-[#788A82]"></div>
                <p class="mt-5 text-base leading-7 text-[#6C766F]">
                    At The Book Store, we bring together books from different
                    categories so readers can explore new ideas, enjoy memorable
                    stories, and discover fresh perspectives.
                </p>
                <p class="mt-4 text-base leading-7 text-[#6C766F]">
                    Whether you enjoy fiction, biographies, personal development,
                    classics, fantasy, or inspiring real-life stories, there is
                    always something new to explore.
                </p>
                <p class="mt-4 text-base leading-7 text-[#6C766F]">
                    We believe books help us learn, grow our knowledge, and see
                    the world in new ways. Our goal is to make discovering books
                    simple, enjoyable, and welcoming for everyone.
                </p>
                <div class="mt-7 flex flex-wrap gap-3">
                    <span class="rounded-full border border-[#D9E0DA] bg-[#F7F5EF] px-4 py-2 text-xs font-semibold text-[#52685D]">Quality Reads</span>
                    <span class="rounded-full border border-[#D9E0DA] bg-[#F7F5EF] px-4 py-2 text-xs font-semibold text-[#52685D]">Multiple Categories</span>
                    <span class="rounded-full border border-[#D9E0DA] bg-[#F7F5EF] px-4 py-2 text-xs font-semibold text-[#52685D]">For Every Reader</span>
                </div>
            </div>
        </div>
    </section>
    <section class="px-5 py-16 sm:px-10 lg:px-20">
        <div class="mx-auto max-w-6xl">
            <div class="mx-auto mb-10 max-w-2xl text-center">
                <p class="section-label">Why The Book Store?</p>
                <h2 class="mt-3 text-3xl font-bold tracking-tight text-[#34443D] sm:text-4xl">More Than Just Books</h2>
                <p class="mt-4 leading-7 text-[#6C766F]">We want every visit to help you discover something worth reading.</p>
            </div>
            <div class="grid gap-5 md:grid-cols-3">
                <article class="feature-card rounded-2xl border border-[#E1E5DE] bg-white p-6 shadow-sm sm:p-7">
                    <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-[#E8EDE8] text-[#52685D]">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 7v14"></path>
                            <path d="M3 18V5a2 2 0 0 1 2-2h3a4 4 0 0 1 4 4 4 4 0 0 1 4-4h3a2 2 0 0 1 2 2v13a2 2 0 0 1-2 2h-5a2 2 0 0 0-2 2 2 2 0 0 0-2-2H5a2 2 0 0 1-2-2z"></path>
                        </svg>
                    </div>
                    <h3 class="mt-5 text-lg font-bold text-[#34443D]">A Wide Collection</h3>
                    <p class="mt-3 text-sm leading-7 text-[#6C766F]">
                        Explore a variety of books, from timeless classics and fiction
                        to biographies, fantasy, and self-help.
                    </p>
                </article>
                <article class="feature-card rounded-2xl border border-[#E1E5DE] bg-white p-6 shadow-sm sm:p-7">
                    <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-[#F0EADF] text-[#8B7045]">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="11" cy="11" r="8"></circle>
                            <path d="m21 21-4.35-4.35"></path>
                            <path d="M8 11h6"></path>
                            <path d="M11 8v6"></path>
                        </svg>
                    </div>
                    <h3 class="mt-5 text-lg font-bold text-[#34443D]">Easy to Explore</h3>
                    <p class="mt-3 text-sm leading-7 text-[#6C766F]">
                        Browse book listings and categories with a simple, clear,
                        and user-friendly experience.
                    </p>
                </article>
                <article class="feature-card rounded-2xl border border-[#E1E5DE] bg-white p-6 shadow-sm sm:p-7">
                    <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-[#EAF0F2] text-[#456875]">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                            <circle cx="10" cy="7" r="4"></circle>
                            <path d="M20 21v-2a4 4 0 0 0-3-3.87"></path>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                        </svg>
                    </div>
                    <h3 class="mt-5 text-lg font-bold text-[#34443D]">Books for Everyone</h3>
                    <p class="mt-3 text-sm leading-7 text-[#6C766F]">
                        Whether you are a student, a curious learner, or a book lover,
                        find something that matches your interests.
                    </p>
                </article>
            </div>
        </div>
    </section>
    <section class="border-y border-[#E0E5DF] bg-[#E8EDE8] px-5 py-16 sm:px-10 lg:px-20">
        <div class="mx-auto max-w-6xl">
            <div class="mb-9 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
                <div>
                    <p class="section-label">From Our Collection</p>
                    <h2 class="mt-3 text-3xl font-bold tracking-tight text-[#34443D] sm:text-4xl">Books Worth Discovering</h2>
                    <p class="mt-3 leading-7 text-[#6C766F]">Take a look at some popular titles from our book collection.</p>
                </div>
                <a href="/books" class="inline-flex w-fit items-center gap-2 rounded-lg border border-[#D9E0DA] bg-white px-5 py-3 text-sm font-semibold text-[#34443D] transition hover:bg-[#34443D] hover:text-white">
                    View All Books →
                </a>
            </div>
            <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
                <% if (featuredBooks && featuredBooks.length > 0) { %>
                    <% featuredBooks.forEach(book => { %>
                        <article class="book-card overflow-hidden rounded-2xl border border-[#E1E5DE] bg-white shadow-sm">
                            <div class="overflow-hidden bg-[#F1F0E9]">
                                <% if (book.image) { %>
                                    <img
                                        src="<%= book.image %>"
                                        alt="Cover of <%= book.title %>"
                                        class="book-cover"
                                        loading="lazy"
                                        onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                                    >
                                    <div class="book-placeholder">
                                        <span class="text-xs font-semibold"><%= book.title %></span>
                                    </div>
                                <% } else { %>
                                    <div class="book-placeholder" style="display:flex;">
                                        <span class="text-xs font-semibold"><%= book.title %></span>
                                    </div>
                                <% } %>
                            </div>
                            <div class="p-3 sm:p-4">
                                <h3 class="min-h-[42px] text-sm font-bold leading-5 text-[#34443D] sm:text-base"><%= book.title %></h3>
                                <p class="mt-1 truncate text-xs text-[#6C766F]">By <%= book.author || 'Unknown Author' %></p>
                                <a href="/books" class="mt-3 inline-flex items-center gap-1 text-xs font-semibold text-[#52685D] transition hover:text-[#34443D]">
                                    Explore <span>→</span>
                                </a>
                            </div>
                        </article>
                    <% }) %>
                <% } else { %>
                    <p class="col-span-full py-10 text-center text-[#6C766F]">
                        No books found. Please add books to your collection.
                    </p>
                <% } %>
            </div>
        </div>
    </section>
    <section class="px-5 py-16 sm:px-10 lg:px-20">
        <div class="mx-auto max-w-6xl overflow-hidden rounded-2xl bg-[#34443D] px-6 py-12 text-center shadow-sm sm:px-12 sm:py-16">
            <p class="text-xs font-bold uppercase tracking-[0.2em] text-[#D5DFD6]">Your Next Chapter Starts Here</p>
            <h2 class="mt-4 text-3xl font-bold text-white sm:text-4xl">Read. Learn. Grow.</h2>
            <p class="mx-auto mt-4 max-w-2xl text-sm leading-7 text-white/75 sm:text-base">
                Discover stories, explore new ideas, and find books that inspire
                you to see the world differently.
            </p>
            <a href="/books" class="mt-7 inline-flex items-center gap-2 rounded-lg bg-[#E8EDE8] px-7 py-3.5 text-sm font-semibold text-[#34443D] transition hover:bg-white">
                Find Your Next Book →
            </a>
        </div>
    </section>
    <footer class="border-t border-[#E4E6DF] bg-[#F7F5EF] px-5 py-7 sm:px-10">
        <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-3 text-center sm:flex-row sm:text-left">
            <div>
                <p class="text-lg font-bold text-[#34443D]">The Book Store</p>
                <p class="mt-1 text-sm text-[#6C766F]">Read. Learn. Grow.</p>
            </div>
            <p class="text-sm text-[#6C766F]">
                © <%= new Date().getFullYear() %> The Book Store. All rights reserved.
            </p>
        </div>
    </footer>
</body>
</html>