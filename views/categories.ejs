<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Book Categories | The Book Store</title>

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    <style>
        body {
            font-family: 'DM Sans', sans-serif;
        }

        h1, h2, h3 {
            font-family: 'DM Sans', sans-serif;
        }

        .book-card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .book-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(36, 53, 45, 0.10);
        }

        .category-link {
            transition: all 0.25s ease;
        }
    </style>
</head>

<body class="min-h-screen bg-[#f7f5ef] text-[#28382e]">

    <%- include('includes/nav.ejs') %>

    <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
        <section class="relative mb-10 overflow-hidden rounded-3xl bg-[#e9eee5] px-6 py-12 text-center sm:px-12 sm:py-16">

        

            <div class="relative z-10">

                <span class="mb-4 inline-block rounded-full border border-[#cbd7c7] bg-white/70 px-4 py-1.5 text-xs font-bold uppercase tracking-[0.2em] text-[#315b43]">
                    Find Your Next Read
                </span>

                <h1 class="text-4xl font-bold tracking-tight text-[#24352d] sm:text-5xl md:text-6xl">
                    Explore Book Categories
                </h1>

                <p class="mx-auto mt-4 max-w-xl text-sm leading-7 text-gray-600 sm:text-base">
                    From inspiring stories to knowledge-filled pages,
                    discover books that match your interests.
                </p>

                <div class="mx-auto mt-6 h-1 w-16 rounded-full bg-[#c5a46d]"></div>

            </div>
        </section>
        <section class="mb-10">

            <div class="mb-5 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">

                <div>
                    <p class="text-xs font-bold uppercase tracking-[0.18em] text-[#8b9a86]">
                        Browse Collections
                    </p>

                    <h2 class="mt-1 text-2xl font-bold text-[#24352d] sm:text-3xl">
                        Choose a Category
                    </h2>
                </div>

                <p class="text-sm text-gray-500">
                    Find something you'll love
                </p>

            </div>

            <div class="flex flex-wrap gap-2.5">

                <a href="/categories"
                   class="category-link rounded-full bg-[#315b43] px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-[#244832]">
                    All Categories
                </a>

                <% categories.forEach(category => { %>

                    <a href="/categories/<%= encodeURIComponent(category) %>"
                       class="category-link rounded-full border border-[#dce1d8] bg-white px-5 py-2.5 text-sm font-semibold text-[#46564a] hover:border-[#315b43] hover:bg-[#315b43] hover:text-white">
                        <%= category %>
                    </a>

                <% }) %>

            </div>
        </section>
        <section>

            <div class="mb-6 flex items-center justify-between gap-3">

                <div>
                    <p class="text-xs font-bold uppercase tracking-[0.18em] text-[#8b9a86]">
                        Our Collection
                    </p>

                    <h2 class="mt-1 text-2xl font-bold text-[#24352d] sm:text-3xl">
                        Discover Your Next Book
                    </h2>
                </div>

                <span class="shrink-0 rounded-full border border-[#dce1d8] bg-white px-4 py-2 text-sm font-semibold text-[#315b43]">
                    <%= books.length %> Books
                </span>

            </div>


            <% if (books.length > 0) { %>
                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">

                    <% books.forEach(book => { %>
                        <article class="book-card flex items-start gap-3 overflow-hidden rounded-xl border border-[#E1E5DE] bg-white p-3 sm:gap-4">

                            <div class="flex h-40 w-24 shrink-0 items-center justify-center overflow-hidden rounded-lg bg-[#E8EDE8] p-1.5 sm:h-44 sm:w-28">

                                <% if (book.image) { %>

                                    <img
                                        src="<%= book.image.startsWith('http') ? book.image : '/' + book.image.replace(/^\/+/, '') %>"
                                        alt="<%= book.title %> book cover"
                                        class="h-full w-full object-contain"
                                        loading="lazy"
                                        onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                                    >

                                    <div class="hidden h-full w-full flex-col items-center justify-center text-[#789078]">
                                        <span class="text-3xl">📚</span>
                                    </div>

                                <% } else { %>

                                    <div class="flex h-full w-full flex-col items-center justify-center text-[#789078]">
                                        <span class="text-3xl">📚</span>
                                    </div>

                                <% } %>

                            </div>

                            <div class="flex min-h-40 min-w-0 flex-1 flex-col self-stretch py-1 sm:min-h-44">
                                <div class="mb-2">

                                    <span class="inline-block max-w-full truncate rounded-full bg-[#edf3eb] px-2.5 py-1 text-[10px] font-semibold text-[#315b43] sm:text-xs">
                                        <%= book.category %>
                                    </span>

                                </div>

                                <h3 class="line-clamp-2 text-sm font-bold leading-snug text-[#24352d] transition hover:text-[#54765a] sm:text-base">
                                    <%= book.title %>
                                </h3>

                                <p class="mt-2 line-clamp-2 text-xs leading-5 text-gray-500 sm:text-sm">
                                    <%= book.author %>
                                </p>


                                <div class="mt-auto flex flex-wrap items-center justify-between gap-2 border-t border-[#E1E5DE] pt-3">

                                    <p class="text-base font-bold text-[#315b43] sm:text-lg">
                                        ₹<%= book.price %>
                                    </p>

                                    <a href="/books"
                                       class="inline-flex items-center gap-1 rounded-lg bg-[#315b43] px-2.5 py-2 text-xs font-semibold text-white transition hover:bg-[#244832] sm:px-3">
                                        View
                                        <span aria-hidden="true">&rarr;</span>
                                    </a>

                                </div>

                            </div>

                        </article>

                    <% }) %>

                </div>

            <% } else { %>
                <div class="rounded-3xl border border-dashed border-[#ccd6c9] bg-white px-5 py-16 text-center">

                    <div class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-2xl bg-[#edf3eb] text-3xl">
                        📚
                    </div>

                    <h3 class="text-2xl font-bold text-[#24352d]">
                        No Books Found
                    </h3>

                    <p class="mx-auto mt-3 max-w-md text-sm leading-6 text-gray-500">
                        There are no books in this category yet.
                        Please explore other categories or check back later.
                    </p>

                    <a href="/categories"
                       class="mt-6 inline-flex rounded-xl bg-[#315b43] px-6 py-3 text-sm font-semibold text-white transition hover:bg-[#244832]">
                        Explore All Categories
                    </a>

                </div>

            <% } %>

        </section>
        <section class="mt-12 rounded-2xl border border-[#e3e3d9] bg-white px-6 py-8 text-center sm:px-10">

            <h2 class="text-2xl font-bold text-[#24352d] sm:text-3xl">
                Every Book Opens a New World
            </h2>

            <p class="mx-auto mt-3 max-w-xl text-sm leading-6 text-gray-500">
                Take your time, explore our collection, and find your next favourite read.
            </p>

            <a href="/books"
               class="mt-5 inline-flex items-center gap-2 rounded-xl border border-[#315b43] px-6 py-3 text-sm font-semibold text-[#315b43] transition hover:bg-[#315b43] hover:text-white">
                Explore All Books
                <span aria-hidden="true">&rarr;</span>
            </a>

        </section>

    </main>
    <footer class="mt-12 border-t border-[#e2e2d9] bg-[#f0efe7]">

        <div class="mx-auto max-w-7xl px-5 py-6 text-center">

            <p class="text-sm text-gray-500">
                © <%= new Date().getFullYear() %> The Book Store.
                Made for people who love reading.
            </p>

        </div>

    </footer>

</body>
</html>